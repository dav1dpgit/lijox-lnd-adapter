# ═══════════════════════════════════════════════════════════════════
# lijox-adapter — FULL CONFIGURATION SURFACE (v0.48)
# Copy to .env beside lij-adapter.js (or point systemd EnvironmentFile
# at it), chmod 600. Three zones:
#   REQUIRED — no defaults; the adapter refuses to start without them.
#   POLICY   — your business terms; defaults shown are the shipped ones.
#   TUNING   — operational knobs; touch only with a reason.
# Every default below is read from the code, not from documentation.
# ═══════════════════════════════════════════════════════════════════

# ── ZONE 1: REQUIRED (identity — who this provider is) ─────────────
ADAPTER_SECRET=            # admin/route auth. Generate: openssl rand -hex 32
NODE_PUBKEY=               # your Lightning node public key (66-char hex)
NODE_HOST=                 # your node's PUBLIC Lightning P2P address, host:port
PUBLIC_HTTPS_URL=          # public HTTPS URL fronting this adapter's HTTP API
PUBLIC_WSS_URL=            # public WSS URL fronting the browser peer proxy
WS_ALLOWED_ORIGINS=        # comma list of wallet web origins allowed to connect

# ── LND CONNECTION ──────────────────────────────────────────────────
#LND_ENDPOINT=https://localhost:8080     # LND REST
#LND_GRPC_ENDPOINT=localhost:10009       # LND gRPC
#LND_PEER_HOST=localhost                 # LND P2P host (WS proxy pipes here)
#LND_PEER_PORT=9735                      # LND P2P port
#LND_TLS_CERT_PATH=~/.lnd/tls.cert       # LND TLS cert
#LIJ_ADAPTER_MACAROON_HEX=               # REQUIRED — bake a least-privilege macaroon: see MACAROON.md

# ── ZONE 2: POLICY ──────────────────────────────────────────────────
#NODE_NAME=LIJOX Node                    # display name wallets see
#LIJOX_REGISTRY=                         # registry URL; UNSET = run registry-free
#FEE_PPM=1000                            # advertised routing fee ppm
#LSPS2_FEE_PPM=1000                      # JIT channel fee ppm
#LSPS2_BASE_FEE_MSAT=1000                # JIT base fee
#CHANNEL_OPEN_FEE_MIN_SATS=100          # channel-opening fee floor (every rail)
#CHANNEL_OPEN_FEE_PPM=100                # ...or this share of the payment, whichever is more (100 ppm = 0.01%)
#CHANNEL_SIZE_SATS=500000                # default JIT channel size
#MIN_CHANNEL_SATS=100000                 # floor
#MAX_CHANNEL_SATS=2000000                # ceiling
#PUSH_SATS=250000                        # sats pushed to wallet side at open
#LSPS2_COMMITMENT_TYPE=ANCHORS           # ANCHORS (stock lnd) | STATIC_REMOTE_KEY (patched lnd)
#LSPS2_MIN_PAYMENT_SIZE_MSAT=1000000     # smallest payment served
#LSPS2_MAX_PAYMENT_SIZE_MSAT=1000000000  # largest payment served
#LSPS2_VAR_ENABLED=true                  # variable-hold fee tier
#LSPS2_VAR_CEILING_MSAT=                 #   its ceiling (see code default)
#JIT_MIN_ONCHAIN_RESERVE_SATS=2000000    # never JIT below this onchain reserve
#JIT_FEE_FREE_OPENS=5                    # free opens per wallet before fee steps
#JIT_FEE_STEP_PCT=50                     # fee step per additional open
#JIT_SCARCITY_MAX_PCT=300                # max scarcity fee multiplier
#JIT_SCARCITY_RAMP_START_SATS=           # scarcity ramp start (see code default)
#JIT_REMOTE_RESERVE_SATS=                # wallet-side reserve at JIT open, SATS.
                                         # unset/0 = LND default ~1%. Floor ~354
                                         # (BOLT2 dust; proto3 cannot send true 0).
                                         # New channels only. Trade documented in
                                         # code: near-zero-stake cheater is
                                         # justice-claimed by the always-on LSP.

# ── ZONE 2 MODULES (each inert/off unless configured) ───────────────
#CHAIN_BRIDGE_ENABLED=true               # cooperative chain-data bridge
#VAPID_PUBLIC_KEY=                       # web-push wake notifications:
#VAPID_PRIVATE_KEY=                      #   generate: npx web-push generate-vapid-keys
#VAPID_SUBJECT=mailto:admin@example.com
#DELEGATE_SECRET=                        # delegate rail auth; empty = rail inert
#DELEGATE_SLIP_MAX_MSAT=150000000        # per-slip cap
#DELEGATE_DAILY_MSAT=1000000000          # per-day cap
#DELEGATE_MAX_LIVE=100                   # live slips cap
#DELEGATE_MAX_HORIZON_S=86400            # slip horizon
#DELEGATE_SPEND_TIMEOUT_S=12
#DELEGATE_FUNDING_EXPIRY_S=900
#DELEGATE_BALANCE_CHECK=on
#DELEGATE_STORE_FILE=                    # default: DATA_DIR/delegate-slips.json
#LEASE_ENABLE=false                      # connection-based channel expiry (dormant)
#LEASE_DRY_RUN=true
#LEASE_DAYS=60
#LEASE_CYCLE_MINUTES=60
#LEASE_LNCLI=lncli                       # lease shells out to lncli (only CLI dep)
#LEASE_WORLD_PEER=                       # pubkey never leased
#LEASE_EXCLUDE_CHANPOINTS=
#LEASE_EXCLUDE_PATH=                     # 0.72.4: the operator's EXCLUSION list, set and saved from the console (DATA_DIR/lease-exclude.json, never in git); the lease closes nothing until it has been saved once
#LEASE_WALLETS_PATH=                     # the persisted set of wallet peers (JIT open targets) — used for the console's 'wallet' label
#RATES_UPSTREAM=                         # rates proxy upstream (see code default)
#RATES_TTL_SECONDS=120
#RATES_STALE_SECONDS=3600
#CRITICAL_PEERS=                         # comma pubkey@host:port kept connected
#LIJ_QUORUM_DEFAULT_ENDPOINTS=           # comma esplora URLs served to wallets

# ── ZONE 3: TUNING ──────────────────────────────────────────────────
#ADAPTER_PORT=7000
#WS_PROXY_PORT=7001
#HTTP_ALLOWED_ORIGINS=                   # CORS; falls back to WS_ALLOWED_ORIGINS
#RATE_LIMIT_REQUESTS=3                   # channel requests per IP per window
#RATE_LIMIT_WINDOW_MS=3600000
#ADMIN_RATE_LIMIT_REQUESTS=60
#ADMIN_RATE_LIMIT_WINDOW_MS=60000
#LSPS2_INTERCEPTOR_ENABLED=true
#LSPS2_OFFLINE_HOLD_ENABLED=             # (see code default)
#LSPS2_OFFLINE_HOLD_CAP_MS=180000        # ceiling; wallet prefs dial within it
#LSPS2_OFFLINE_MIN_HEADROOM_BLOCKS=18
#LSPS2_AGG_WINDOW_S=60                   # MPP shard aggregation window
#LSPS2_MIN_SHARD_MSAT=1000
#LSPS2_HTLC_SAFETY_BLOCKS=10
#LSPS2_PROMISE_VALIDITY_SECS=600
#LSPS2_RESERVATION_HOURS=24
#LSPS2_RECONNECT_POLL_SECS=5
#LSPS2_OPENCHANNEL_TIMEOUT_MS=25000

# 0.66.0 — fee policy of every channel this LSP opens to a wallet (set in the
# open; an hourly sweep corrects older private wallet channels; the world
# peer is never touched)
#LIJ_CHAN_BASE_FEE_MSAT=0
#LIJ_CHAN_FEE_PPM=1000
#LIJ_CHAN_POLICY_ENFORCE=true

# 0.68.0 — the neutral host every static address is written under; this LSP
# claims each name at the LIJOX registry worker with its node key. Empty =
# addresses stay on this LSP's own host.
#LNURLP_ADDRESS_HOST=lightninginajar.xyz
#LSPS2_SENDTOROUTE_TIMEOUT_MS=25000
#LSPS2_VAR_QUIESCE_MS=8000
#LSPS2_CHANNEL_BUFFER_SATS=50000
#ROUTE_BUILD_USE_MC=on                   # mission-control-aware route building
#PUSH_SUBS_MAX=10000
#REGISTRY_DB_PATH=                       # default: DATA_DIR/registry.db
#ATTEMPT_JOURNAL_PATH=                   # default: DATA_DIR/attempt-journal.json
#LEASE_STATE_PATH=                       # default: DATA_DIR/lease-state.json
#LEASE_LOG_PATH=                         # default: DATA_DIR/lease-log.ndjson
#LIJ_TELEMETRY_DARK_MS=                  # (see code default)

# ── DATA & PRIVACY ──────────────────────────────────────────────────
#LIJ_DATA_DIR=                           # ONE state root; default = beside the code;
                                         # set /var/lib/lijox-adapter with the unit file
#LOG_CLIENT_IP=off                       # client IPs are NOT logged unless 'on'
#HEALTH_DETAIL=off                       # 'on' = /health includes lnd_version
                                         # + ops counters, and /health/jit is
                                         # public. Off = wallet-needs only,
                                         # /health/jit needs the admin secret.
#LIJOX_DOCTOR=on                          # startup checks (cert, macaroon, LND
                                         # reach, identity match, gRPC port,
                                         # data-dir write). 'off' skips.

# ── 0.71.0: registry liveness + the operator console ────────────────────────────
#LIJOX_REGISTER_EVERY_HOURS=6            # re-register on this cadence; the registry marks a record stale after 24h without one (0 = boot only)
#CONSOLE_TOTP_SECRET=                     # from `node lij-adapter.js --totp-enroll`; unset = console disabled
#CONSOLE_PORT=7004                        # the console listens here on 127.0.0.1 and on the Tailscale interface only
#CONSOLE_TAILSCALE=true                   # also bind every address of an interface named tailscale*; false = loopback only
#CONSOLE_BIND=                            # extra addresses to bind (comma list) — never a public one; the console has no place on the tunnel
#CONSOLE_SESSION_HOURS=12                 # a correct code sets a session for this long, bound to the caller's address
#LIJ_DATA_DIR=                           # the adapter's data dir (registries, tapes, lease state, and since 0.72.0 pl-events.ndjson + pl-daily.json); default: the install dir
#LEASE_SESSION_GAP_MIN=10                # 0.73.0: a wallet's contact after this much silence starts a new session (one state write + one log line per session)
#CONSOLE_NOTES_PATH=                     # 0.73.0: console notes + wallet labels (DATA_DIR/console-notes.json, per instance, never in git)
#CONSOLE_NOTES_IMPORT=                   # one-time import of an old lij-console notes.json (default ~/lij-console/notes.json) when ours is absent
