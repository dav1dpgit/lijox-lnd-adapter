# ═══════════════════════════════════════════════════════════════════
# lijox-adapter — FULL CONFIGURATION SURFACE (v0.48)
# Copy to .env beside lij-adapter.js (or point systemd EnvironmentFile
# at it), chmod 600. Three zones:
#   REQUIRED — no defaults; the adapter refuses to start without them.
#   POLICY   — your business terms; defaults shown are the shipped ones.
#   TUNING   — operational knobs; touch only with a reason.
# Every default below is read from the code, not from documentation.
# ═══════════════════════════════════════════════════════════════════

# ── ZONE 1: REQUIRED (identity — who this provider is) ─────────────
ADAPTER_SECRET=            # admin/route auth. Generate: openssl rand -hex 32
NODE_PUBKEY=               # your Lightning node public key (66-char hex)
NODE_HOST=                 # your node's PUBLIC Lightning P2P address, host:port
PUBLIC_HTTPS_URL=          # public HTTPS URL fronting this adapter's HTTP API
PUBLIC_WSS_URL=            # public WSS URL fronting the browser peer proxy
WS_ALLOWED_ORIGINS=        # comma list of wallet web origins allowed to connect

# ── LND CONNECTION ──────────────────────────────────────────────────
#LND_ENDPOINT=https://localhost:8080     # LND REST
#LND_GRPC_ENDPOINT=localhost:10009       # LND gRPC
#LND_PEER_HOST=localhost                 # LND P2P host (WS proxy pipes here)
#LND_PEER_PORT=9735                      # LND P2P port
#LND_TLS_CERT_PATH=~/.lnd/tls.cert       # LND TLS cert
#LND_REST_CA_PATH=                       # 0.95.0: check LND REST's certificate against this file; empty = no check
                                         #   (LND on this machine). On a Start9: StartOS's root CA.
#LIJ_ADAPTER_MACAROON_HEX=               # REQUIRED — bake a least-privilege macaroon: see MACAROON.md

# ── ZONE 2: POLICY ──────────────────────────────────────────────────
#NODE_NAME=LIJOX Node                    # display name wallets see
#LIJOX_REGISTRY=                         # registry URL; UNSET = run registry-free
#LIJOX_REGISTRIES=                       # 0.118.0: every registry to enroll at, comma-separated (the first is read) — overrides LIJOX_REGISTRY
#FEE_PPM=1000                            # advertised routing fee ppm
#LSPS2_FEE_PPM=1000                      # JIT channel fee ppm
#LSPS2_BASE_FEE_MSAT=1000                # JIT base fee
#CHANNEL_OPEN_FEE_MIN_SATS=100          # channel-opening fee floor (every rail)
#CHANNEL_OPEN_FEE_PPM=100                # ...or this share of the payment, whichever is more (100 ppm = 0.01%)
#CHANNEL_SIZE_SATS=500000                # default JIT channel size
#MIN_CHANNEL_SATS=100000                 # floor
#MAX_CHANNEL_SATS=2000000                # ceiling
#PUSH_SATS=250000                        # sats pushed to wallet side at open
#LSPS2_COMMITMENT_TYPE=ANCHORS           # ANCHORS (stock lnd) | STATIC_REMOTE_KEY (patched lnd)
#LSPS2_MIN_PAYMENT_SIZE_MSAT=1000000     # smallest payment served
#LSPS2_MAX_PAYMENT_SIZE_MSAT=1000000000  # largest payment served
#LSPS2_VAR_ENABLED=true                  # variable-hold fee tier
#LSPS2_VAR_CEILING_MSAT=                 #   its ceiling (see code default)
#JIT_MIN_ONCHAIN_RESERVE_SATS=2000000    # never JIT below this onchain reserve
#JIT_FEE_LADDER_SATS=100,400,1000,2000,3000,5000,10000,15000   # 0.90.0: a wallet's 1st, 2nd … JIT open in the window; the last repeats
#LSPS2_JIT_WINDOW_DAYS=90                # the window the ladder counts in
#JIT_SCARCITY_MAX_PCT=300                # max scarcity fee multiplier
#JIT_SCARCITY_RAMP_START_SATS=           # scarcity ramp start (see code default)
#JIT_REMOTE_RESERVE_SATS=                # wallet-side reserve at JIT open, SATS.
                                         # unset/0 = LND default ~1%. Floor ~354
                                         # (BOLT2 dust; proto3 cannot send true 0).
                                         # New channels only. Trade documented in
                                         # code: near-zero-stake cheater is
                                         # justice-claimed by the always-on LSP.

# ── ZONE 2 MODULES (each inert/off unless configured) ───────────────
#CHAIN_BRIDGE_ENABLED=true               # cooperative chain-data bridge
#VAPID_PUBLIC_KEY=                       # web-push wake notifications:
#VAPID_PRIVATE_KEY=                      #   generate: npx web-push generate-vapid-keys
#VAPID_SUBJECT=mailto:admin@example.com
#DELEGATE_SECRET=                        # delegate rail auth; empty = rail inert
#DELEGATE_SLIP_MAX_MSAT=150000000        # per-slip cap
#DELEGATE_DAILY_MSAT=1000000000          # per-day cap
#DELEGATE_MAX_LIVE=100                   # live slips cap
#DELEGATE_MAX_HORIZON_S=86400            # slip horizon
#DELEGATE_SPEND_TIMEOUT_S=12
#DELEGATE_FUNDING_EXPIRY_S=900
#DELEGATE_BALANCE_CHECK=on
#DELEGATE_OWN_ONLINE_WINDOW_MS=60000      # 0.91.0: a chit paying a wallet's address on this LSP, wallet connected: the least window
#DELEGATE_STORE_FILE=                    # default: DATA_DIR/delegate-slips.json
#LEASE_ENABLE=false                      # connection-based channel expiry (dormant)
#LEASE_DRY_RUN=true
#LEASE_DAYS=60
#LEASE_CYCLE_MINUTES=60
#LEASE_LNCLI=lncli                       # lease shells out to lncli (only CLI dep)
#LEASE_WORLD_PEER=                       # pubkey never leased
#LEASE_EXCLUDE_CHANPOINTS=
#LEASE_EXCLUDE_PATH=                     # 0.72.4: the operator's EXCLUSION list, set and saved from the console (DATA_DIR/lease-exclude.json, never in git); the lease closes nothing until it has been saved once
#LEASE_WALLETS_PATH=                     # the persisted set of wallet peers (JIT open targets) — used for the console's 'wallet' label
#RATES_UPSTREAM=                         # rates proxy upstream (see code default)
#RATES_TTL_SECONDS=120
#RATES_STALE_SECONDS=3600
#CRITICAL_PEERS=                         # comma pubkey@host:port kept connected
#LIJ_QUORUM_DEFAULT_ENDPOINTS=           # comma esplora URLs served to wallets

# ── ZONE 3: TUNING ──────────────────────────────────────────────────
#ADAPTER_PORT=7000
#WS_PROXY_PORT=7001
#HTTP_ALLOWED_ORIGINS=                   # CORS; falls back to WS_ALLOWED_ORIGINS
#RATE_LIMIT_REQUESTS=3                   # channel requests per IP per window
#RATE_LIMIT_WINDOW_MS=3600000
#ADMIN_RATE_LIMIT_REQUESTS=60
#ADMIN_RATE_LIMIT_WINDOW_MS=60000
#WALLET_CHECK_IP_REQUESTS=120            # 0.96.0: my-channels + recover-close per address per window, checked before
#WALLET_CHECK_IP_WINDOW_MS=600000        #   LND checks the signature (many phones can share one address)
#MY_CHANNELS_KEY_REQUESTS=60             # 0.96.0: per node key per key window, once the signature proves the key
#RECOVER_CLOSE_KEY_REQUESTS=10
#WALLET_CHECK_KEY_WINDOW_MS=3600000

# ── LIJOX's Tatara — Mix pools (0.97.0; off unless TATARA_ENABLED=true; slice 1 declares the limits only) ──
#TATARA_ENABLED=false                 # offer Tatara pools at all
#TATARA_SIZES=50000,100000,250000,1000000   # pool sizes offered (sats), each at least 10,000
#TRUST_FORWARDED_FOR=false            # 0.105.2: read x-forwarded-for (its last hop) for the per-IP limits — ONLY behind a proxy that overwrites it; Cloudflare's cf-connecting-ip is always taken
#TATARA_MIN_PEOPLE=3                  # LiJ wallets join only 3–6
#TATARA_MAX_PEOPLE=6
#TATARA_COUNTDOWN_S=600               # from the MIN_PEOPLE-th joiner
#TATARA_WAKE_WINDOW_S=180             # to open after the wake
#TATARA_MAX_RETRIES=2
#TATARA_STRIKES=4                     # pools stopped at the anonymous step in a row before a wallet leaves the list
#TATARA_MAX_POOLS_PER_SIZE=3          # pools of one size running at once
#TATARA_MAX_POOLS_TOTAL=10            # all pools running at once
#TATARA_MAX_LIST_PER_SIZE=60          # waiting-list length per size
#TATARA_MAX_FEE_RATE=20               # sat/vB cap for a pool's funding and exits
#TATARA_CHANNEL_POOLS=false           # on-chain → channel pools (0.103.0); true needs TATARA_CHANNEL_SIZES and LND's maxpendingchannels at 3 or more
#TATARA_CHANNEL_SIZES=               # on-chain → channel pool sizes (0.105.0: their own list — need not be among TATARA_SIZES)
#TATARA_FORWARD_PAYOUTS=true          # forward other providers' wallets' payout registrations
#TATARA_RELAY_FOR_OTHERS=true         # run the private relay for other providers' pools
#TATARA_FORWARD_COIN_CHECKS=true      # pass other providers' wallets' coin checks on
#TATARA_COIN_CHECK_URL=               # this provider's filter server answering coin checks (its /coin); empty = none
#TATARA_PUBLIC_ROOMS=true             # 0.106.0 (Phase 2b): a size with seats waiting but fewer than TATARA_MIN_PEOPLE gets a room on the public Joinstr relay (N = the minimum; the LIJOX pool wins if the list fills by itself first)
#TATARA_PUBLIC_RELAY=wss://relay.primal.net   # the public relay the rooms are announced on (the public joinstr code's default)
#TATARA_ROOM_WINDOW_S=1200            # a room stays open this long (300–3600, at least twice TATARA_WAKE_WINDOW_S); announced again while seats wait
#LSPS2_INTERCEPTOR_ENABLED=true
#LSPS2_OFFLINE_HOLD_ENABLED=true         # default ON (0.80.0): hold forwards for offline wallets, each wallet's own dial within the ceiling; false = every offline send fails at once
#LSPS2_OFFLINE_HOLD_CAP_MS=180000        # ceiling; wallet prefs dial within it
#LSPS2_OFFLINE_MIN_HEADROOM_BLOCKS=18
# Push Key (0.82.0): the delivery fee the sender pays on top of the amount (the recipient gets the amount
# exactly); a cross-provider delivery may spend up to it, the rest stays with this provider.
#PUSH_DELIVERY_FEE_BASE_MSAT=1000
#PUSH_DELIVERY_FEE_PPM=2000
#PUSH_CLTV_MARGIN_BLOCKS=144             # added to the window's blocks on the lock's timelock (72 h → 576); 144 since 0.113.0 (was 40) — about a day for the sender to come online after a last-minute take
#PUSH_HOLD_FEE_PPM_PER_DAY=0             # 0.113.0: a hold fee inside the lock's fee — per million of the amount, per day of the window (rounded up); 0 = none
#PUSH_MIN_SATS=100
#PUSH_MAX_SATS=5000000
#PUSH_CLAIM_HOLD_MS=900000               # how long a claim invoice waits for the wallet to take the delivery
#PUSH_DELIVER_TIMEOUT_S=90               # LND's clock on a cross-provider delivery
# Routing reports (0.113.0, docs/design/pathfinding in the wallet repo): a wallet's signed report of the nodes and
# channels that refused its payment is written into this node's LND routing memory (XImportMissionControl — the
# macaroon needs it), so later route asks avoid them. Only signed reports write; a route ask's own exclusions never do.
#ROUTE_REPORT_MAX_PAIRS_PER_HOUR=20      # per wallet
# NWC (0.86.0): this provider keeps a Nostr app's encrypted NIP-47 requests for its sleeping wallets and wakes
# them; it never pays, never reads a request. OFF by default (a LIJOX operator's choice). The relay rides the
# API tunnel at wss://<PUBLIC_HTTPS_URL host>/nwc — no new port. Node-1 (the UM890) runs it on; Node-2 stays off.
#NWC_ENABLED=true
#NWC_REQUEST_TTL_CEILING_S=3600           # the longest a waiting request is kept; each wallet's own dial governs within it
#LSPS2_AGG_WINDOW_S=60                   # MPP shard aggregation window
#LSPS2_MIN_SHARD_MSAT=1000
#LSPS2_HTLC_SAFETY_BLOCKS=10
#LSPS2_PROMISE_VALIDITY_SECS=600          # the quote clock: an ask whose wallet never registered an invoice secret is dropped after this
#LSPS2_RESERVATION_HOURS=24               # the reservation clock: a promise with its invoice secret registered lives this long (0.119.2 — before, every promise went at the quote clock); must cover the wallet's invoice life (LiJ: 60 min) plus its longest hold
#LSPS2_MAX_LIVE_PROMISES_PER_WALLET=10    # 0.119.2: over it, the wallet's oldest idle promise (no shards, no open in flight, no held payment) is dropped for the new ask; every one busy = the ask is refused
#LSPS2_MAX_LIVE_PROMISES=2000             # 0.119.2: over it, every ask is refused with a plain message until promises expire
# 0.119.3 (S66): the fetch for the phone — POST /v1/lnurl/fetch fetches a payee's pay terms or invoice for a wallet the
# payee's server refused (CORS); https on 443 to a public address only, no redirects, 64 KiB, 10 s; the URL is never logged
#LNURL_FETCH_IP_PER_MIN=30                # asks per address per minute; over it 429
#LSPS2_RECONNECT_POLL_SECS=5
#LSPS2_OPENCHANNEL_TIMEOUT_MS=25000

# 0.66.0 — fee policy of every channel this LSP opens to a wallet (set in the
# open; an hourly sweep corrects older private wallet channels; the world
# peer is never touched)
#LIJ_CHAN_BASE_FEE_MSAT=0
#LIJ_CHAN_FEE_PPM=1000
#LIJ_CHAN_POLICY_ENFORCE=true

# 0.68.0 — the neutral host every static address is written under; this LSP
# claims each name at the LIJOX registry worker with its node key. Empty =
# addresses stay on this LSP's own host.
#LNURLP_ADDRESS_HOST=lightninginajar.xyz
#LSPS2_SENDTOROUTE_TIMEOUT_MS=25000
#LSPS2_VAR_QUIESCE_MS=8000
#JIT_GRANT_BASE_SATS=25000               # 0.90.0: JIT channel = payment + granted; every JIT gets this
#JIT_GRANT_BONUS_PCT=50                  #   + this % (rounded down) of the payment above …
#JIT_GRANT_BONUS_FROM_SATS=25000         #   … this
#JIT_GRANT_CEILING_SATS=62500            #   granted never exceeds this
#ROUTE_BUILD_USE_MC=on                   # mission-control-aware route building
#PUSH_SUBS_MAX=10000
#REGISTRY_DB_PATH=                       # default: DATA_DIR/registry.db
#ATTEMPT_JOURNAL_PATH=                   # default: DATA_DIR/attempt-journal.json
#LEASE_STATE_PATH=                       # default: DATA_DIR/lease-state.json
#LEASE_LOG_PATH=                         # default: DATA_DIR/lease-log.ndjson
#LIJ_TELEMETRY_DARK_MS=                  # (see code default)

# ── DATA & PRIVACY ──────────────────────────────────────────────────
#LIJ_DATA_DIR=                           # ONE state root; default = beside the code;
                                         # set /var/lib/lijox-adapter with the unit file
#LOG_CLIENT_IP=off                       # client IPs are NOT logged unless 'on'
#HEALTH_DETAIL=off                       # 'on' = /health includes lnd_version
                                         # + ops counters. Off = wallet-needs only.
                                         # (0.111.0: /health/jit is gone from the
                                         # public API — the console's JIT · now pane.)
#LIJOX_DOCTOR=on                          # startup checks (cert, macaroon, LND
                                         # reach, identity match, gRPC port,
                                         # data-dir write). 'off' skips.

# ── 0.71.0: registry liveness + the operator console ────────────────────────────
#LIJOX_REGISTER_EVERY_HOURS=6            # re-register on this cadence; the registry marks a record stale after 24h without one (0 = boot only)
#LIJOX_FILTER_URL=                       # 0.87.0: the public https address of this box's block-filter server (docs/adapter-standalone-setup.md §10);
                                         # checked at every registration and offered in the signed record when it answers; unset = none offered
#PUBLIC_REACH=cloudflare                  # 0.108.0: what sits between the wallet and this box on PUBLIC_HTTPS_URL / PUBLIC_WSS_URL / LIJOX_FILTER_URL —
                                         # `cloudflare` (a Cloudflare tunnel ends TLS; the default when unset) or `direct` (TLS ends on this machine:
                                         # a blind relay such as ops/relay, or a port forward). Signed into the LIJOX record as route 1; wallets show the
                                         # word as a badge and may refuse Cloudflare. A door that CLAIMS direct but answers with Cloudflare's own header
                                         # is registered as cloudflare and the journal says so.
#ROUTE_2_REACH=                          # 0.108.0: a second door into the same box — e.g. the Cloudflare names beside direct ones (ROUTE_3_* a third).
#ROUTE_2_HTTPS_URL=                      # all three addresses of the second door; its filter server is offered only when it answers /tip
#ROUTE_2_WSS_URL=
#ROUTE_2_FILTER_URL=
#CONSOLE_TOTP_SECRET=                     # from `node lij-adapter.js --totp-enroll`; unset = console disabled
#CONSOLE_PORT=7004                        # the console listens here on 127.0.0.1 and on the Tailscale interface only
#CONSOLE_TAILSCALE=true                   # also bind every address of an interface named tailscale*; false = loopback only
#CONSOLE_BIND=                            # extra addresses to bind (comma list) — never a public one; the console has no place on the tunnel
#CONSOLE_SESSION_HOURS=12                 # a correct code sets a session for this long, bound to the caller's address
#LIJ_DATA_DIR=                           # the adapter's data dir (registries, tapes, lease state, and since 0.72.0 pl-events.ndjson + pl-daily.json); default: the install dir
#LEASE_SESSION_GAP_MIN=10                # 0.73.0: a wallet's contact after this much silence starts a new session (one state write + one log line per session)
#CONSOLE_NOTES_PATH=                     # 0.73.0: console notes + wallet labels (DATA_DIR/console-notes.json, per instance, never in git)
#CONSOLE_NOTES_IMPORT=                   # one-time import of an old lij-console notes.json (default ~/lij-console/notes.json) when ours is absent


# 0.104.0 — the JIT guard: a JIT channel whose funding was published and whose payment then FAILED is a
# "funded-but-failed" open. Counted on a rolling 24 h: at JIT_GUARD_ARM_AT the Console reads "shutdown ARMED",
# at JIT_GUARD_HALT_AT every JIT open is refused until released from the Console (Guardrails). 0 = that step off.
# JIT_GUARD_ARM_AT=2
# JIT_GUARD_HALT_AT=3
# 0.111.0: the halt counts DISTINCT WALLETS with a funded-but-failed open in 24 h (a griefer with a million wallets
# still trips it at wallet three); ONE wallet's own repeat failures block THAT wallet alone at JIT_GUARD_WALLET_AT
# (for 24 h after its last failure, or until released from the Console's Guardrails). 0 = no per-wallet block.
# JIT_GUARD_WALLET_AT=2

# 0.120.0 — LIGHTNING PAYS ON-CHAIN (the wallet pays an on-chain address from its Lightning balance; the design is
# docs/design/onchain-pay/lightning-paying-onchain-v0.6.md in the wallet repo). The box needs a FLOAT WALLET: a wallet
# inside its own Bitcoin Core, under an RPC user whose command list is whitelisted (rpcwhitelist — with
# rpcwhitelistdefault=0 beside it, or every other RPC user loses every command), holding no more than the daily
# ceiling, topped up by hand. The adapter never gains a right on LND for this. Without the three RPC settings and
# the seed the service is off and says so at boot. ONCHAIN_PAY_ENABLED=false stops NEW payments only — the open
# ones run to their end (take-backs, collections, status).
# 0.121.0 — the lease's one warning: LEASE_WARN_DAYS before a channel's lease would close it, one push to its wallet (a wallet
# with Wake push on), once per channel lifetime; never in dry run. The Backups pane reads LND's channel.backup for its facts.
# LEASE_WARN_DAYS=2
# 0.122.0 — the fee rates are decimal (Core's own; the floor of 4 sat/vB in the chain bridge is gone); nothing to set.
# 0.124.0 — WALLET TRUSTS LSP: a JIT channel's funding is published only once the wallet has claimed the payment, for
# wallets that announce init feature bit 261 (LiJ engine v363+); older wallets get the publish-first open. Needs six RPCs
# in the key (MACAROON.md) — the boot probe says. false turns it off for every wallet. The coins of a held funding are
# leased under the adapter's own lock id for LSPS2_FUNDING_HOLD_LOCK_SECONDS (48 h) — released on abandon, spent on publish.
# LSPS2_FUNDING_HOLD=true
# LSPS2_FUNDING_HOLD_LOCK_SECONDS=172800
# 0.124.1 — the JIT funding's fee, BOTH opens (held and publish-first): LND's estimate for this many blocks, polled at each
# open (144 = about a day — a zero-conf channel is in use at once), never below the floor, never above the cap when one is
# set (0 = no cap). Until 0.124.0 every JIT open carried a hard-coded 1 sat/vB.
# 0.124.2 — the rate is kept in LND's own unit (sat/kw; 1 sat/vB = 250 sat/kw) and not rounded: the held open gives LND
# sat/kw, the publish-first open the nearest whole sat/vB. The two dials below stay in sat/vB.
# LSPS2_FUNDING_FEE_TARGET_CONF=144
# LSPS2_FUNDING_FEE_MIN_SAT_PER_VB=1
# LSPS2_FUNDING_FEE_MAX_SAT_PER_VB=0
# LIJ_SCB_FILE=/home/USER/.lnd/data/chain/bitcoin/mainnet/channel.backup
# ONCHAIN_PAY_ENABLED=false
# ONCHAIN_PAY_RPC_URL=http://127.0.0.1:8332/wallet/lij-onchain-pay
# ONCHAIN_PAY_RPC_USER=lijpay
# ONCHAIN_PAY_RPC_PASS=
# ONCHAIN_PAY_TAKEBACK_SEED=                # 32 bytes hex, made once by the ride; the take-back key and the records' HMAC key derive from it — back it up with this file
# ONCHAIN_PAY_FEE_SATS=1000                 # the provider's flat fee, not refundable once the lock is sent
# ONCHAIN_PAY_FEE_PPM=2000                  # a share of the amount on top: 2000 ppm = 0.2% (0.120.5; was 0) — not refundable either
# ONCHAIN_PAY_MIN_SATS=10000               # 0.120.4: 10,000 (was 20,000)
# ONCHAIN_PAY_MAX_SATS=2000000
# ONCHAIN_PAY_REFUND_BLOCKS=144             # the take-back window: T = the block at the lock + this
# ONCHAIN_PAY_DAILY_SATS=2000000            # locked in any rolling 24 hours, all wallets
# ONCHAIN_PAY_MAX_OPEN=10                   # box-wide; no per-wallet cap

# 0.126.0 — the channel state file's holder (POST /v1/peer-storage/put | meta | get). One encrypted file per wallet,
# 65,531 bytes at most, kept in DATA_DIR/peer-storage/. The limits, per hour:
# PEER_STORAGE_IP_PER_HOUR=600
# PEER_STORAGE_KEY_PER_HOUR=300

# 0.127.0 — a delivery in parts: when no one channel to a wallet has the room but its channels together do, the
# provider's own delivery (address payment, Push Key, chit) goes one part per channel and no channel is opened.
# LSPS2_DELIVER_MAX_PARTS=4                 # the most channels one delivery may use
# LSPS2_DELIVER_MIN_PART_SATS=1000          # no part smaller than this
