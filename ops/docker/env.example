# LIJOX adapter — the Docker .env (ops/docker, adapter 0.109.1).
# Copy this file to .env in the same folder, fill it in, then: chmod 600 .env
# One setting per line, no quotes, no spaces around "=". Lines starting with # are ignored.
# This file is the adapter's whole config (the full list with every default is ../../config.env.example).
# REQUIRED lines are marked. Everything else works as it stands.

# ══ A. DOCKER ONLY — read by docker compose, not by the adapter ══════════════════════════════════════════
# REQUIRED. The host folder the adapter keeps its state in (registries, kits, tapes, PL ledger, console notes).
# Make it first: mkdir -p /opt/lijox-data && sudo chown 1000:1000 /opt/lijox-data   (uid 1000 = the container's user)
LIJOX_DATA_HOST=/opt/lijox-data

# REQUIRED. The HOST path of LND's tls.cert — the adapter needs it to speak gRPC to LND. Pick the line for your box:
#   a plain Ubuntu/Debian node (lnd as user "lnd" or you):   /home/<user>/.lnd/tls.cert
#   Umbrel:                   /home/umbrel/umbrel/app-data/lightning/data/lnd/tls.cert
#   RaspiBlitz:               /mnt/hdd/lnd/tls.cert   (symlinked from /home/bitcoin/.lnd/tls.cert)
#   Start9 / StartOS 0.4:     /media/startos/data/package-data/volumes/lnd/data/main/tls.cert   (the "main" volume is
#                             mounted at /root/.lnd inside LND's container — Start9Labs/lnd-startos README; NOT checked
#                             on a live box, read it with `sudo ls` first; see docs/operator-docker-runbook.md §2)
# The container must be able to READ it: sudo chmod 644 <that path>   (a certificate is public; this is safe).
LND_TLS_CERT_HOST=/home/CHANGE_ME/.lnd/tls.cert

# ══ B. REQUIRED — who this provider is (the adapter refuses to start without all seven) ══════════════════
# The route token. The registry hands it to every wallet, so it is PUBLIC by design; it protects nothing secret.
# Make one:  openssl rand -hex 32
ADAPTER_SECRET=

# Your LND node's public key, 66 hex characters.  lncli getinfo → identity_pubkey
NODE_PUBKEY=

# How other Lightning nodes reach your node: host:port. Tor:  <your-onion>.onion:9735   Relay:  <VPS_IP>:9735
NODE_HOST=

# The public https address of the adapter's API — the name your front door sends to port 7000.
PUBLIC_HTTPS_URL=https://lsp.example.net

# The public wss address of the wallets' Lightning link — the name your front door sends to port 7001.
PUBLIC_WSS_URL=wss://ws.example.net

# The wallet web origins allowed to connect (comma list, no trailing slash). The LiJ wallet's is this one:
WS_ALLOWED_ORIGINS=https://lightninginajar.xyz

# The baked macaroon, as hex (MACAROON.md; runbook §3). NEVER the admin macaroon.
LIJ_ADAPTER_MACAROON_HEX=

# ══ C. LND — where LND is, as seen from the box (host network: "localhost" is the box itself) ═══════════
# LND's REST port. Plain nodes, Umbrel, RaspiBlitz: https://localhost:8080. Start9: the port LND's REST is bound
# to on the box — read it on the box first (runbook §2); it may not be 8080.
LND_ENDPOINT=https://localhost:8080
# LND's gRPC port (the HTLC interceptor and the chain bridge stream over it).
LND_GRPC_ENDPOINT=localhost:10009
# LND's Lightning peer port (the wallets' websocket is piped here).
LND_PEER_HOST=localhost
LND_PEER_PORT=9735
# Do NOT set LND_TLS_CERT_PATH here — the compose file sets it to /lnd/tls.cert (the mount of LND_TLS_CERT_HOST).
# Optional: a CA file to check LND's REST certificate against (empty = no check, which is right for LND on the
# same box). The compose file mounts only tls.cert, so a CA file would need its own mount.
#LND_REST_CA_PATH=

# ══ D. POLICY — your terms (defaults shown; change what you mean to change) ════════════════════════════
# The name wallets see.
NODE_NAME=My LIJOX Node
# The registry to list in. Empty or absent = run registry-free (no wallet finds you). Leave it OFF for the first start:
# the record would name a front door that does not exist yet. Runbook §6c turns it on once the door answers. The LiJ
# registry is https://lij-worker.dp-a95.workers.dev (any LIJOX registry works the same way).
#LIJOX_REGISTRY=https://lij-worker.dp-a95.workers.dev
# The channel type of every channel this provider opens to a wallet. STATIC_REMOTE_KEY needs DP's Terminus-patched
# LND (runbook §1); on stock LND it FAILS every JIT open. ANCHORS works on stock LND but the LiJ wallet REFUSES anchors
# channels from its provider (engine v312+), so a stock-LND provider serves no LiJ wallet. See runbook §1.
LSPS2_COMMITMENT_TYPE=STATIC_REMOTE_KEY
# Routing fee advertised, parts per million.
FEE_PPM=1000
# What a channel open costs the wallet: the larger of this floor (sats) and this share of the payment (100 ppm = 0.01%).
CHANNEL_OPEN_FEE_MIN_SATS=100
CHANNEL_OPEN_FEE_PPM=100
# Channel sizes (sats): the default JIT size, the floor, the ceiling.
CHANNEL_SIZE_SATS=500000
MIN_CHANNEL_SATS=100000
MAX_CHANNEL_SATS=2000000
# Never open a JIT channel while the node's confirmed on-chain balance is below this (sats).
JIT_MIN_ONCHAIN_RESERVE_SATS=2000000
# The lease: a wallet silent for LEASE_DAYS gets its channel force-closed, its balance paid to its own address.
# Off here. Read README.md "The operator console" and KNOWN-FINDINGS 2026-09-08 before turning it on.
LEASE_ENABLE=false
# The lease (and recover-close) shell out to lncli. INSIDE THE CONTAINER THERE IS NO lncli — see runbook §9 before
# enabling the lease; until then leave this as it is.
#LEASE_LNCLI=lncli

# ══ E. THE FRONT DOORS (0.108.0) — what sits between the wallet and this box ═══════════════════════════
# cloudflare = a Cloudflare tunnel ends TLS at Cloudflare's edge (the default when unset).
# direct     = TLS ends on THIS box (Caddy behind the ops/relay kit, or a port forward).
# Signed into your registry record as route 1; wallets will show it as a badge (runbook §6).
PUBLIC_REACH=cloudflare
# A second door into the same box (e.g. the direct names beside the Cloudflare ones) — all three lines, or none.
#ROUTE_2_REACH=direct
#ROUTE_2_HTTPS_URL=https://direct-lsp.example.net
#ROUTE_2_WSS_URL=wss://direct-ws.example.net
#ROUTE_2_FILTER_URL=
# Behind Caddy (the direct door) ONLY: take the client address Caddy writes into x-forwarded-for. NEVER behind
# Cloudflare alone (Cloudflare's own header is always read).
#TRUST_FORWARDED_FOR=true

# ══ F. OPTIONAL MODULES (off or absent unless set) ══════════════════════════════════════════════════════
# Your own block-filter server (needs bitcoind on the box; docs/adapter-standalone-setup.md §10). Empty = none.
#LIJOX_FILTER_URL=https://filters.example.net
# Web-push wake for sleeping wallets:  npx web-push generate-vapid-keys
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.net
# NWC (zaps from Nostr apps through sleeping wallets). Off by default.
#NWC_ENABLED=true
# Mix pools (LIJOX's Tatara). Off by default; read README.md "Mix pools" first.
#TATARA_ENABLED=false
# Delegated spends (chits). Empty = the rail is off. Any random string turns it on:  openssl rand -hex 32
#DELEGATE_SECRET=

# ══ G. THE OPERATOR CONSOLE — your monitor, on the box's loopback only ═════════════════════════════════
# From `docker compose run --rm lijox-adapter node /app/lij-adapter.js --totp-enroll` (runbook §8). Empty = no console.
#CONSOLE_TOTP_SECRET=
# The console's port. It binds 127.0.0.1 (and tailscale* interfaces if the box has them) — never the LAN.
CONSOLE_PORT=7004
# Extra addresses to bind — only if you know why. Never a public one.
#CONSOLE_BIND=

# ══ H. TUNING — leave as they are ═══════════════════════════════════════════════════════════════════════
# The adapter's two ports. The compose file passes these to the health check too.
ADAPTER_PORT=7000
WS_PROXY_PORT=7001
# /health detail: off = what wallets need; on = also LND's version and counters (public).
HEALTH_DETAIL=off
# Client addresses are not logged unless on.
LOG_CLIENT_IP=off
# Re-register with the registry every N hours (the registry marks a record stale after 24 h without one).
LIJOX_REGISTER_EVERY_HOURS=6
